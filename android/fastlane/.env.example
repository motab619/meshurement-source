# Copy to android/fastlane/.env and fill in. Never commit .env or the JSON key.
#
# Google Play service account with release rights for this app
# (docs/design/android/README.md, "Play Console steps": Google Cloud →
# service account → JSON key; Play Console → Users and permissions → invite
# the service account's email with "Release to testing tracks" and
# "Release to production" for Meshurement). Keep the file out of the project.
PLAY_JSON_KEY=~/.play/meshurement-play-publisher.json

# The AI Lambda's shared app token (tool/ai-analysis/README.md "App token");
# the same value as ios/fastlane/.env.
AI_APP_TOKEN=

# Track for `fastlane beta`: internal (default, no review, up to 100 testers)
# or alpha (= the default "Closed testing" track; the one that counts for
# the 12 testers / 14 days rule).
PLAY_TRACK=internal
# Status of a testing release. Must be "draft" until the app has been
# through its first review (Play refuses other statuses on a draft app);
# then "completed" makes the release live for the track's testers.
PLAY_RELEASE_STATUS=draft

# Signing. The keystore itself is NOT configured here: Gradle reads
# android/key.properties (storeFile, storePassword, keyAlias, keyPassword),
# which tool/android/make_keystore.sh explains how to write. The lanes only
# check that it exists and that the bundle is not debug-signed.
# Optional extra check: the upload certificate's SHA-256 fingerprint (not a
# secret; `keytool -list -v -keystore <file> -alias upload` or Play Console →
# Test and release → App integrity → Upload key certificate).
UPLOAD_CERT_SHA256=
