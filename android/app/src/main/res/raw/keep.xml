<!-- Resources named only in Dart strings (looked up by name with
     getIdentifier): the release resource shrinker (isShrinkResources) can't
     see them and dropped ic_stat_notify, so flutter_local_notifications
     (main.dart AndroidInitializationSettings) and geolocator's recording
     notification (gps_service.dart) had no small icon in release builds.
     Add any other drawable/raw referenced by name from Dart here. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notify,@drawable/launch_image" />
