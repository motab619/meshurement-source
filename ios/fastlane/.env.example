# Copy to ios/fastlane/.env and fill in (App Store Connect → Users and
# Access → Integrations → App Store Connect API → Team Keys).
ASC_KEY_ID=
ASC_ISSUER_ID=
# Where you saved the downloaded AuthKey_XXXXXXXXXX.p8 (keep it out of the project)
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
# The AI Lambda's shared app token (tool/ai-analysis/README.md "App token");
# the same value the function was deployed with as AppToken.
AI_APP_TOKEN=
